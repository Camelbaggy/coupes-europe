ards":0,"saves":0,"clean_sheet":1,"goals_conceded":0}},"joue":true},{"id":"250184653","nom":"Ahmet Bircan","nom_court":"AHMET SAMİ","poste":"FORWARD","poste_fr":"Attaquant","numero":"70","age":19,"naissance":"2007-01-24","pays":"TUR","nationalite":"Turquie","drapeau":"tr","photo":"https://img.uefa.com/imgml/TP/players/14/2027/324x324/250184653.jpg","stats":{"uel":{"matches_appearance":1,"minutes_played_official":4,"goals":0,"assists":0,"yellow_cards":0,"red_cards":0,"goals_conceded":0}},"joue":true},{"id":"250163518","nom":"Semih Kılıçsoy","nom_court":"SEMİH","poste":"FORWARD","poste_fr":"Attaquant","numero":"90","age":21,"naissance":"2005-08-15","pays":"TUR","nationalite":"Turquie","drapeau":"tr","photo":"https://img.uefa.com/imgml/TP/players/14/2027/324x324/250163518.jpg","stats":{"uel":{"matches_appearance":4,"minutes_played_official":71,"goals":1,"assists":0,"yellow_cards":0,"red_cards":0,"saves":0,"clean_sheet":0,"goals_conceded":0}},"joue":true}],"maj":"2026-11-25T06:22:32Z","wikipedia":{"extrait":"Le Beşiktaş Jimnastik Kulübü est la section football d'un club turc fondé le 3 mars 1903 pour la gymnastique, mais la section football ne voit le jour qu'en 1911. Le club est basé à Istanbul dans le quartier du même nom et joue ses matchs à domicile dans le Stade İnönü du BJK jusqu'en 2013, année où commence la construction de son nouveau stade, le Vodafone Park, nouveau nom depuis juin 2017, auparavant Vodadone Arena, dont la construction s'est achevée par son inauguration officielle sans ses supporters le 10 avril 2016, suivie le lendemain par un premier match dans une ambiance survoltée. Les matchs à domicile du club sont dans un premier temps délocalisés au Recep Tayyip Erdoğan Stadyumu et au Stade olympique Atatürk pour la saison 2013-2014, puis uniquement au Stade olympique Atatürk à partir de la saison 2014-2015.","titre":"Beşiktaş JK (football)","url":"https://fr.wikipedia.org/wiki/Be%C5%9Fikta%C5%9F_JK_(football)","licence":"CC BY-SA 4.0","licence_url":"https://creativecommons.org/licenses/by-sa/4.0/deed.fr","maj":"2026-11-25T06:22:32Z"}}
